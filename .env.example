# CortexMesh Environment Configuration

# Required for JWT session authentication
USER_AUTH_SECRET=your_super_secret_jwt_key_here

# At least one model provider is required:
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional LangSmith Tracing & Observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=cortexmesh

# Service Configuration
HOST=0.0.0.0
PORT=8000
AGENT_URL=http://localhost:8000
ENABLE_USER_AUTH=true
